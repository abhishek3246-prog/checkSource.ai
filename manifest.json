{
  "manifest_version": 3,
  "name": "checkSource.ai",
  "version": "1.7.0",
  "description": "Hover any image to check if it looks original or AI-made. Free for Chrome on Mac and Windows.",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://checksource-ai.vercel.app/*",
    "https://www.checksource.ai/*",
    "https://checksource.ai/*",
    "https://api-inference.huggingface.co/*",
    "https://router.huggingface.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/report.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "checkSource.ai",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "welcome.html", "welcome.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
